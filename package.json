{
  "name": "pulso-crm",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4310",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4310",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src test *.json *.ts *.mjs docs README.md .github/workflows",
    "format:check": "prettier --check src test *.json *.ts *.mjs docs README.md .github/workflows",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --test test/access.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
